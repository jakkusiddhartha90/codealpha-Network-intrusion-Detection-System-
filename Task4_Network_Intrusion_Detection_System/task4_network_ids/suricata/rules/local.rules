# NetGuard educational local rules.
# These are examples for an authorized lab. Tune thresholds to avoid false positives.
# Rule 1: repeated TCP SYN packets from one source to many destination ports (port-scan indicator).
alert tcp any any -> $HOME_NET any (msg:"NETGUARD Possible TCP SYN port scan"; flags:S; flow:stateless; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# Rule 2: repeated inbound connection attempts to SSH (possible brute-force indicator).
alert tcp any any -> $HOME_NET 22 (msg:"NETGUARD Repeated SSH connection attempts"; flags:S; flow:stateless; threshold:type both, track by_src, count 8, seconds 60; classtype:attempted-admin; sid:1000002; rev:1;)

# Rule 3: unusually frequent ICMP echo requests (possible ping flood indicator).
alert icmp any any -> $HOME_NET any (msg:"NETGUARD ICMP echo request burst"; itype:8; threshold:type both, track by_src, count 30, seconds 10; classtype:attempted-dos; sid:1000003; rev:1;)
